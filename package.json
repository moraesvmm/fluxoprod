{
  "name": "fluxoprod-root",
  "private": true,
  "workspaces": [
    "apps/web",
    "whatsapp-service"
  ],
  "scripts": {
    "sql:verify-gen": "node scripts/generate-verify-sql-from-types.mjs",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w apps/web",
    "start": "npm run start -w apps/web",
    "whatsapp:dev": "npm run dev -w whatsapp-service",
    "whatsapp:build": "npm run build -w whatsapp-service",
    "web:build": "npm run build -w apps/web"
  }
}
