{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "fluxo-wa-v113": {
      "source": {
        "root": "whatsapp-service"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      }
    },
    "fluxoprod": {
      "source": {
        "root": "."
      },
      "config": {
        "buildCommand": "npm install && npm run build -w apps/web",
        "startCommand": "npm run start -w apps/web"
      }
    }
  }
}
